{
  "name": "nexus",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "description": "NEXUS – Premium Personal Control Center (Chrome Extension, Manifest V3)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:release": "tsc --noEmit && vite build --mode release",
    "release": "npm run build:release && node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/vazirmatn": "5.3.0",
    "lucide-react": "0.453.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-iconly": "2.2.10"
  },
  "devDependencies": {
    "@types/chrome": "0.0.280",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.14",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
